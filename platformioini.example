; Modelo do platformio.ini deste projeto. O platformio.ini nao vai para o git
; (cada PC tem seus caminhos): copie este arquivo para platformio.ini antes de
; compilar.
;
; Para guardar os pacotes do PlatformIO em outra pasta, acrescente na seção
; [platformio] do seu platformio.ini:
;   core_dir = D:/DevTools/.platformio
;
; Please visit documentation for the other options and examples
; https://docs.platformio.org/page/projectconf.html

[platformio]
; Sem -e, grava só o mestre. Sem isso, um upload gravaria os dois programas
; em sequência na mesma placa.
default_envs = mestre

[env]
platform = freescalekinetis
board = frdm_kl25z
framework = zephyr
platform_packages = platformio/framework-zephyr@~3.40200.0
monitor_speed = 115200

; Upload pelo LinkServer (MCUXpresso) em vez de copiar o .bin para o drive
; DAPLINK: grava o ELF via SWD, reseta a placa e falha de verdade se der erro.
; O comando de upload (LinkServer mais novo em C:/NXP) e o arm-none-eabi-size
; (bloqueado pelo Smart App Control no toolchain do PlatformIO) vem do
; mcuxpresso_tools.py. Sem LinkServer, troque por upload_protocol = mbed
; (copia o firmware.bin para o drive DAPLINK).
; O zephyr_link_fix.py passa -mcpu/-mthumb ao link: sem isso a libgcc em modo
; ARM derruba o Cortex-M0+ com HardFault no boot.
; O device_guard_fix.py troca o g++ pelo gcc: o Device Guard (Smart App
; Control) do Windows pode bloquear o arm-none-eabi-g++.exe.
; O zephyr_overlay_fix.py faz o build refazer o devicetree quando só o
; zephyr/app.overlay muda; sem ele, o firmware sai com os pinos antigos.
upload_protocol = custom
extra_scripts =
    pre:zephyr_overlay_fix.py
    post:mcuxpresso_tools.py
    post:zephyr_link_fix.py
    post:device_guard_fix.py

; Um ambiente por placa, cada um compila só o seu arquivo de src/:
;   pio run -e mestre -t upload        mestre (etapa 2)
;   pio run -e escrava -t upload       escrava (etapa 2)
;   pio run -e placa_unica -t upload   mestre rodando sozinho (etapa 1)
; O upload não escolhe a placa: na hora de gravar, deixe só uma placa no USB do
; PC. Os fios entre as placas (src/README.md, seção 4.2) podem ficar ligados.
[env:mestre]
build_src_filter = +<*> -<escrava.c>

[env:escrava]
build_src_filter = +<*> -<mestre.c>

[env:placa_unica]
build_src_filter = +<*> -<escrava.c>
build_flags = -DUMA_PLACA=1
